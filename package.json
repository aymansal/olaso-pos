{
  "name": "olaso-pos",
  "private": true,
  "version": "0.1.0-rc.4",
  "type": "module",
  "scripts": {
    "theme:build": "astryx theme build Olasotheme-theme.ts",
    "check:pos": "node scripts/check-pos.mjs",
    "check:convex": "convex codegen --typecheck enable",
    "seed:dev": "convex run seed:resetAndSeed \"{\\\"confirm\\\":\\\"RESET_OLASO_DEV\\\"}\"",
    "check:seed": "convex run seed:verify",
    "check:management": "node scripts/check-management.mjs",
    "check:local-management": "node --disable-warning=ExperimentalWarning scripts/check-local-management.mjs",
    "check:local-catalog": "node --disable-warning=ExperimentalWarning scripts/check-local-catalog.mjs",
    "check:local-inventory-costs": "node --disable-warning=ExperimentalWarning scripts/check-local-inventory-costs.mjs",
    "check:local-staff": "node --disable-warning=ExperimentalWarning scripts/check-local-staff.mjs",
    "check:lock-switch": "node --disable-warning=ExperimentalWarning scripts/check-lock-switch.mjs",
    "check:navigation": "node scripts/check-navigation.mjs",
    "check:inventory": "node scripts/check-inventory.mjs",
    "check:costs": "node scripts/check-costs.mjs",
    "check:staff": "node scripts/check-staff.mjs",
    "check:expenses": "node scripts/check-expenses.mjs",
    "check:monthly-costs": "node scripts/check-monthly-costs.mjs",
    "check:local": "node --disable-warning=ExperimentalWarning scripts/check-local-database.mjs",
    "check:sales": "node --disable-warning=ExperimentalWarning scripts/check-sales.mjs",
    "check:orders": "node --disable-warning=ExperimentalWarning scripts/check-orders.mjs",
    "check:dashboard": "node scripts/check-dashboard.mjs",
    "check:reports": "node scripts/check-reports.mjs",
    "check:settings": "node scripts/check-settings.mjs",
    "check:identity": "node scripts/check-identity.mjs",
    "check:reconnect": "node --disable-warning=ExperimentalWarning scripts/check-reconnect.mjs",
    "check:offline": "node scripts/check-offline-views.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:android": "node scripts/check-android-beta.mjs",
    "check:release": "node scripts/check-release.mjs",
    "measure:android": "node scripts/measure-android-baseline.mjs",
    "check:printing": "node scripts/check-printing.mjs",
    "check:printing-endurance": "node --disable-warning=ExperimentalWarning scripts/check-printing-endurance.mjs",
    "check:receipt-lab": "npm --prefix tools/wd8260-receipt-lab run check",
    "prepare:sqlite-web": "node scripts/prepare-sqlite-web.mjs",
    "dev": "npm run theme:build && npm run prepare:sqlite-web && vite --host 0.0.0.0",
    "build": "npm run theme:build && npm run prepare:sqlite-web && tsc -b && vite build",
    "android:sync": "npm run build && cap sync android",
    "android:beta": "npm run check:android && npm run android:sync && node scripts/build-android-beta.mjs",
    "android:release": "npm run check:release && npm run check:android && npm run android:sync && node scripts/build-android-release.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "preview": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.7",
    "@capacitor-community/sqlite": "8.1.0",
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "convex": "^1.42.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sql.js": "1.11.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.1.7",
    "@capacitor/cli": "8.4.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
